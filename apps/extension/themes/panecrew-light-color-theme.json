{
  "$schema": "vscode://schemas/color-theme",
  "name": "PaneCrew Light",
  "type": "light",
  "colors": {
    "focusBorder": "#b0651f",
    "foreground": "#202020",
    "descriptionForeground": "#606060",
    "errorForeground": "#cf222e",
    "widget.shadow": "#0f172a29",
    "selection.background": "#b0651f40",

    "editor.background": "#ffffff",
    "editor.foreground": "#3b3d40",
    "editorGroup.border": "#f0f1f2",
