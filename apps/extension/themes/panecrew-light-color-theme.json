    "terminal.ansiCyan": "#188184",
    "terminal.ansiWhite": "#7e8084",
    "terminal.ansiBrightBlack": "#717579",
    "terminal.ansiBrightRed": "#d9453e",
    "terminal.ansiBrightGreen": "#1a9951",
    "terminal.ansiBrightYellow": "#9b8a16",
    "terminal.ansiBrightBlue": "#585fdb",
    "terminal.ansiBrightMagenta": "#ba3fad",
