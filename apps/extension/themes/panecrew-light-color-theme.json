    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#202020",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#606060",
    "titleBar.border": "#f0f1f2",

    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#606060",
    "statusBar.border": "#f0f1f2",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#a05605",
    "statusBar.debuggingForeground": "#ffffff",

    "panel.background": "#ffffff",
    "panel.border": "#f0f1f2",
    "panelTitle.activeBorder": "#a05605",
    "panelTitle.activeForeground": "#202020",
    "panelTitle.inactiveForeground": "#606060",

    "button.background": "#a05605",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#b96809",
    "button.secondaryBackground": "#f0f1f2",
    "button.secondaryForeground": "#202020",

    "badge.background": "#a05605",
    "badge.foreground": "#ffffff",

