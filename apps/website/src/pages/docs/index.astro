---
import DocsLayout from "../../layouts/DocsLayout.astro";

const title = "Docs | PaneCrew";
const description =
  "PaneCrew documentation: an interface overview, installing the VS Code extension, how the focus-following explorer works, and the full commands & settings reference.";

const cards = [
  {
    href: "/docs/interface/",
    label: "Interface tour",
    blurb: "A tour of the grid and the PaneCrew explorer, inside VS Code's own activity bar and editor groups.",
  },
  {
    href: "/docs/install/",
    label: "Install & run",
    blurb: "Installing the PaneCrew extension from the Marketplace or a .vsix file.",
  },
  {
    href: "/docs/focus-following-explorer/",
    label: "Focus-following explorer",
    blurb: "How the file tree always tracks whichever pane has focus, and why that's PaneCrew's core mechanic.",
  },
  {
    href: "/docs/cli/",
    label: "Commands & settings",
    blurb: "Every panecrew.* command and setting the extension contributes, and how to bind your own keys to them.",
  },
];
---
<DocsLayout title={title} description={description} path="/docs/" active="index">
  <p class="eyebrow" style="font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--amber); margin-bottom: 14px;">Docs</p>
  <h1>PaneCrew Docs</h1>
  <p class="lede">
    Reference material for running PaneCrew and understanding how it works. For the product
    pitch, see the <a href="/" style="color: var(--amber);">homepage</a>; for task-specific
    write-ups (running several agents at once, multiple terminal windows, ...), see the <a
      href="/guides/multiple-cli-agent-sessions/" style="color: var(--amber);">guides</a>.
  </p>

  <div class="docs-cards">
    {cards.map((card) => (
      <a class="docs-card" href={card.href}>
        <b>{card.label}</b>
        <span>{card.blurb}</span>
      </a>
    ))}
  </div>
</DocsLayout>

<style>
  .docs-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; max-width: 720px; }
  @media (max-width: 560px) { .docs-cards { grid-template-columns: 1fr; } }
  .docs-card {
    display: flex; flex-direction: column; gap: 6px; text-decoration: none;
    padding: 18px 20px; border-radius: 12px;
    background: rgba(255, 253, 245, 0.05); border: 1px solid var(--line-dark);
    transition: transform var(--lift), background var(--lift), border-color var(--lift);
  }
  .docs-card:hover {
    transform: translateY(-2px); background: rgba(255, 253, 245, 0.08);
    border-color: rgba(255, 253, 245, 0.24);
  }
  .docs-card b { color: var(--cream); font-family: var(--display); font-weight: 700; font-size: 1.0625rem; }
  .docs-card span { color: rgba(255, 253, 245, 0.78); font-size: 0.90625rem; }
</style>
