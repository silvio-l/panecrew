<script is:inline>
(function () {
  'use strict';
  var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  var projects = [
    { name: 'orbit-api', files: ['▸ node_modules', '▾ src', ['router.ts', true], ['handlers.ts', false], 'package.json', 'README.md'] },
    { name: 'dashboard', files: ['▸ node_modules', '▾ src/charts', ['usage.tsx', true], ['legend.tsx', false], 'vite.config.ts', 'index.html'] },
    { name: 'cli-tools', files: ['▾ bin', ['release.ts', true], ['publish.ts', false], '▸ test', 'justfile', 'deno.json'] },
    { name: 'panecrew', files: ['▾ apps/desktop', ['src-tauri/', true], ['src/App.tsx', false], '▸ docs', 'CLAUDE.md', 'pnpm-lock.yaml'] } // brandlint-ok: self-referential demo (this repo's own real file tree)
  ];

  /* files is a flat list where a plain string starts a root-level node
     and any tuples immediately following it become that node's children
     — reshape that into real tree nodes, then draw real box-drawing
     connectors (├─/└─/│) off the shape, same idiom as `tree`/ls -R, not
     the old fixed &nbsp;&nbsp; indent that couldn't tell first-of/last-of
     a group apart. */
  function renderExplorer(el, idx, animate) {
    var p = projects[idx];
    var nodes = [];
    p.files.forEach(function (f) {
      if (typeof f === 'string') {
        nodes.push({ label: f, hl: false, children: [] });
      } else if (nodes.length) {
        nodes[nodes.length - 1].children.push({ label: f[0], hl: f[1] });
      }
    });
    var html = '<p class="hd">explorer · follows focus</p>' +
      '<p class="proj">▾ ' + p.name + '</p><ul>';
    nodes.forEach(function (node, i) {
      var lastRoot = i === nodes.length - 1;
      html += '<li><span class="tc">' + (lastRoot ? '└─ ' : '├─ ') + '</span>' + node.label + '</li>';
      node.children.forEach(function (child, j) {
        var lastChild = j === node.children.length - 1;
        var prefix = (lastRoot ? '   ' : '│  ') + (lastChild ? '└─ ' : '├─ ');
        html += '<li' + (child.hl ? ' class="hl"' : '') + '><span class="tc">' + prefix + '</span>' + child.label + '</li>';
      });
    });
    html += '</ul>';
    el.innerHTML = html;
    if (animate && !reduced) {
      el.classList.remove('swap');
      void el.offsetWidth;
      el.classList.add('swap');
    }
  }

  /* ---- focus pin-header + circuit trace geometry ----
     Ported from apps/desktop/src/components/traceGeometry.ts: same
     45°-chamfered bus route, same 2px/ms signal-propagation speed clamped
     to 180–350ms. Pure math, no framework — the site measures its own
     fixed layout with getBoundingClientRect the same way the app measures
     its live grid. */
  function simplifyPoints(points) {
    var deduped = [];
    for (var i = 0; i < points.length; i++) {
      var p = points[i], last = deduped[deduped.length - 1];
      if (last && Math.hypot(p.x - last.x, p.y - last.y) < 0.5) continue;
      deduped.push(p);
    }
    var out = [];
    for (var j = 0; j < deduped.length; j++) {
      var point = deduped[j];
      var a = out[out.length - 2], b = out[out.length - 1];
      if (a && b) {
        var cross = (b.x - a.x) * (point.y - b.y) - (b.y - a.y) * (point.x - b.x);
        var dot = (b.x - a.x) * (point.x - b.x) + (b.y - a.y) * (point.y - b.y);
        if (Math.abs(cross) < 0.5 && dot > 0) out.pop();
      }
      out.push(point);
    }
    return out;
  }

  function chamferedLine(points, chamfer) {
    if (points.length < 3) return points.slice();
    var out = [points[0]];
    for (var i = 1; i < points.length - 1; i++) {
      var prev = points[i - 1], vertex = points[i], next = points[i + 1];
      var inLen = Math.hypot(vertex.x - prev.x, vertex.y - prev.y);
      var outLen = Math.hypot(next.x - vertex.x, next.y - vertex.y);
      var cut = Math.min(chamfer, inLen / 2, outLen / 2);
      out.push(
        { x: vertex.x - (vertex.x - prev.x) / inLen * cut, y: vertex.y - (vertex.y - prev.y) / inLen * cut },
        { x: vertex.x + (next.x - vertex.x) / outLen * cut, y: vertex.y + (next.y - vertex.y) / outLen * cut }
      );
    }
    out.push(points[points.length - 1]);
    return out;
  }

  function pathD(points, chamfer) {
    var line = chamferedLine(points, chamfer);
    if (line.length < 2) return '';
    return line.map(function (p, i) { return (i === 0 ? 'M ' : 'L ') + p.x.toFixed(2) + ' ' + p.y.toFixed(2); }).join(' ');
  }

  function pathLength(points, chamfer) {
    var line = chamferedLine(points, chamfer);
    var total = 0;
    for (var i = 1; i < line.length; i++) total += Math.hypot(line[i].x - line[i - 1].x, line[i].y - line[i - 1].y);
    return total;
  }

  function traceDurationMs(len) {
    return Math.round(Math.min(350, Math.max(180, len / 2)));
  }

  function pointAtArc(line, cum, arc) {
    for (var i = 0; i < cum.length - 1; i++) {
      if (arc <= cum[i + 1] || i === cum.length - 2) {
        var segLen = cum[i + 1] - cum[i];
        var t = segLen > 0 ? (arc - cum[i]) / segLen : 0;
        if (t < 0) t = 0; if (t > 1) t = 1;
        var a = line[i], b = line[i + 1];
        return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
      }
    }
    return line[line.length - 1];
  }

  /* ---- comet packets (performance-audit ticket 10 + the 2026-08-14
     "Tron energy-lane" round-2 redesign, merged 2026-08-15 after the
     redesign was lost to a rebase and restored against this later
     architecture) ----
     A small pool of <circle>s — one bright head plus a shrinking/dimming
     tail — fires as a single packet along the route at irregular
     intervals, eased, with an occasional fast "spark" variant: the same
     firing model the original redesign drove via stroke-dashoffset WAAPI
     sweeps on stacked <path> layers (a paint-triggering SVG property).
     Ported onto the ticket-10 architecture instead: every circle moves
     via WAAPI `transform: translate()` + `opacity` keyframes sampled
     from the route's own polyline vertices (pointAtArc/chamferedLine,
     shared with makeTraceDrawer below) — compositor-only, no repaint,
     and idle (not just looping) between packets. Tail circles reuse the
     head's own keyframes but start `k * lag` ms later on the same
     duration, so they visibly trail the head by that time-distance
     instead of needing a second geometry pass. */
  /* head bumped 1.9 → 3.1 and the tail lengthened 4 → 6 circles
     (2026-08-15, user: couldn't see the animation at all, then: make the
     lane read as a proper Tron energy packet) — a sub-2px cream dot on a
     1.5px dashed channel was below the perception floor at reading
     distance, and a 4-dot tail read as loose dots, not a streak. */
  var COMET_TAIL_COUNT = 8;
  var COMET_TAIL_LAG_MS = 55;
  var COMET_TAIL_RADII = [3.2, 2.75, 2.4, 2.1, 1.8, 1.5, 1.2, 0.95];
  var COMET_TAIL_OPACITY = [1, 0.85, 0.7, 0.55, 0.42, 0.3, 0.2, 0.12];

  function makeCometTrain(groupEl, opts) {
    var pool = []; // { circle, anim }
    var line = [], cum = [], total = 0;
    var timer = null, started = false;

    function ensurePool() {
      while (pool.length < COMET_TAIL_COUNT) {
        var circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('r', String(COMET_TAIL_RADII[pool.length]));
        circle.style.opacity = '0';
        groupEl.appendChild(circle);
        pool.push({ circle: circle, anim: null });
      }
    }
    function clear() {
      pool.forEach(function (s) { if (s.anim) s.anim.cancel(); s.circle.remove(); });
      pool = [];
      if (timer) { clearTimeout(timer); timer = null; }
      started = false;
    }
    function update(points, chamfer) {
      if (!groupEl) return;
      if (reduced || typeof groupEl.animate !== 'function') { clear(); return; }
      var newLine = chamferedLine(points, chamfer);
      if (newLine.length < 2) { clear(); return; }
      var newCum = [0];
      for (var i = 1; i < newLine.length; i++) {
        newCum.push(newCum[i - 1] + Math.hypot(newLine[i].x - newLine[i - 1].x, newLine[i].y - newLine[i - 1].y));
      }
      line = newLine; cum = newCum; total = cum[cum.length - 1];
      // geometry only feeds the NEXT firing (see fire()) — an in-flight
      // packet finishes on whatever route it started on, same as the
      // original stroke-based redesign left a mid-sweep dash alone.
      if (!started && total > 0) { started = true; schedule(0); }
    }
    function travelKeyframes(peakOpacity) {
      /* fade in/out over a short fixed arc (~26px, capped at 18% of the
         route) instead of the previous whole-first/last-segment fade —
         on the short mockup traces that old rule kept the packet
         semi-transparent for most of its flight (2026-08-15 visibility
         fix). Keyframes sit at every route vertex plus the two fade
         boundaries, sorted, so offsets stay monotonic for WAAPI. */
      if (total <= 0) return [];
      var fade = Math.min(0.18, 26 / total);
      var offs = cum.map(function (c) { return Math.min(1, Math.max(0, c / total)); });
      offs.push(fade, 1 - fade);
      offs.sort(function (a, b) { return a - b; });
      var kf = [];
      for (var v = 0; v < offs.length; v++) {
        var off = offs[v];
        if (v > 0 && off - offs[v - 1] < 0.0005) continue;
        var p = pointAtArc(line, cum, off * total);
        var edge = Math.min(off, 1 - off);
        var op = peakOpacity * (fade > 0 ? Math.min(1, edge / fade) : 1);
        kf.push({
          transform: 'translate(' + p.x.toFixed(2) + 'px,' + p.y.toFixed(2) + 'px)',
          opacity: op,
          offset: off,
        });
      }
      return kf;
    }
    function onFlightEnd(circle) {
      return function () { circle.style.opacity = '0'; };
    }
    /* reports the head's EASED route fraction each frame while a packet
       is in flight (getComputedTiming().progress is post-easing, so no
       bezier inversion needed) — lets the caller sync one-off events to
       the packet's actual position (the seam's via-pad blips). Reads
       animation timing only, no style/layout reads; the loop exists
       only between fire() and that flight's end. */
    function watchProgress(anim) {
      function step() {
        var state = anim.playState;
        if (state !== 'running' && state !== 'pending') return;
        var ct = anim.effect.getComputedTiming();
        if (typeof ct.progress === 'number') opts.onProgress(ct.progress);
        requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    function fire() {
      timer = null;
      if (total <= 0) { schedule(0); return; }
      ensurePool();
      var spark = Math.random() < opts.sparkChance;
      var speed = opts.speed * (0.82 + Math.random() * 0.4);
      /* per-instance duration floor (2026-08-15 visibility fix): the old
         fixed 260ms floor meant a whole flight on the ~50–150px mockup
         traces was over in a quarter second — with 1.4–3.6s gaps the
         packet was on screen < 10% of the time and read as "nothing
         there". The spark variant stays a faster cut of the same base. */
      var dur = Math.max(opts.minDur || 260, total / speed);
      if (spark) dur = Math.max(240, dur * 0.55);
      /* tail lag is time-based, so the px spacing it produces scales with
         travel speed — the fast seam route needs a much shorter lag than
         the slow mockup zips or the tail breaks into separate dots. */
      var lag = Math.round((opts.tailLag || COMET_TAIL_LAG_MS) * (spark ? 0.6 : 1));
      var tailCount = spark ? 2 : pool.length;
      for (var k = 0; k < pool.length; k++) {
        var entry = pool[k];
        if (entry.anim) { entry.anim.cancel(); entry.anim = null; }
        if (k >= tailCount) { entry.circle.style.opacity = '0'; continue; }
        entry.anim = entry.circle.animate(
          travelKeyframes(COMET_TAIL_OPACITY[k]),
          { duration: dur, delay: k * lag, easing: opts.easing, fill: 'forwards' }
        );
        entry.anim.onfinish = onFlightEnd(entry.circle);
      }
      if (opts.onProgress && pool[0].anim) watchProgress(pool[0].anim);
      schedule(dur + (tailCount - 1) * lag);
    }
    function schedule(extra) {
      var gap = opts.minGap + Math.random() * (opts.maxGap - opts.minGap);
      timer = setTimeout(fire, extra + gap);
    }
    return { update: update, clear: clear };
  }
  /* short trace, quick zips: a cream packet over the already-solid amber
     conduit (an amber packet would be invisible there). Retuned
     2026-08-15 (user: animation not visible): 650ms duration floor so a
     flight on the short mockup routes is actually perceivable, and
     tighter gaps so a visitor glancing at the mockup catches one. */
  var traceCometOpts = { speed: 0.9, sparkChance: 0.35, minGap: 900, maxGap: 2600, minDur: 650, easing: 'cubic-bezier(0.55, 0, 0.3, 1)' };
  /* the page seam: a long route (thousands of px), so speed matters and
     the duration floor never binds — a packet takes a few seconds to run
     the page, passing whatever section is on screen. Easing is a power
     surge, not a glide: shot out of the start fast, decelerating into
     the terminus (2026-08-15 Tron pass). */
  var seamCometOpts = { speed: 1.1, sparkChance: 0.3, minGap: 1200, maxGap: 2800, minDur: 900, tailLag: 6, easing: 'cubic-bezier(0.16, 0.6, 0.55, 1)' };

  function makeTraceDrawer(appBodyEl, pins, panes, pathEl, padEl, baseEl, cometTrain) {
    return function draw(idx, animate) {
      var pinEl = pins[idx], paneEl = panes[idx];
      if (!appBodyEl || !pinEl || !paneEl || !pathEl || !padEl) return;
      var origin = appBodyEl.getBoundingClientRect();
      var pinRect = pinEl.getBoundingClientRect();
      var paneRect = paneEl.getBoundingClientRect();
      if (paneRect.width <= 0 || paneRect.height <= 0) return;
      var pin = { x: pinRect.left + pinRect.width / 2 - origin.left, y: pinRect.top + pinRect.height / 2 - origin.top };
      var paneLeft = paneRect.left - origin.left;
      var paneTop = paneRect.top - origin.top;
      var paneWidth = paneRect.width;
      var channelY = paneTop - 4;
      var padX = paneLeft + Math.min(16, paneWidth / 2);
      var points = simplifyPoints([pin, { x: pin.x, y: channelY }, { x: padX, y: channelY }, { x: padX, y: paneTop }]);
      var d = pathD(points, 6);
      var len = pathLength(points, 6);
      pathEl.setAttribute('d', d);
      if (baseEl) baseEl.setAttribute('d', d);
      if (cometTrain) cometTrain.update(points, 6);
      padEl.setAttribute('x', String(padX - 4));
      padEl.setAttribute('y', String(paneTop - 4));
      pathEl.style.strokeDasharray = String(len);
      pathEl.style.strokeDashoffset = '0';
      if (animate && !reduced && len > 0 && typeof pathEl.animate === 'function') {
        pathEl.animate(
          [{ strokeDashoffset: String(len) }, { strokeDashoffset: '0' }],
          { duration: traceDurationMs(len), easing: 'linear' }
        );
      }
    };
  }

  /* ---- hero: auto focus-cycle after assembly ---- */
  var heroApp = document.getElementById('heroApp');
  var heroXpl = document.getElementById('heroXpl');
  var heroPanes = Array.prototype.slice.call(heroApp.querySelectorAll('.hpane'));
  var heroPins = Array.prototype.slice.call(heroApp.querySelectorAll('.pin'));
  var heroDrawTrace = makeTraceDrawer(
    heroApp.querySelector('.app-body'), heroPins, heroPanes,
    document.getElementById('heroTracePath'), document.getElementById('heroTracePad'),
    document.getElementById('heroTraceBase'), makeCometTrain(document.getElementById('heroTraceSparks'), traceCometOpts)
  );
  var heroIdx = 0, heroTimer = null, heroTraceReady = false;

  /* one tiny helper for the app-bar HUD readouts (hero + demo): index +
     focused project name, with the same tick entrance the nav readout
     uses — every "instrument" on the page announces state changes the
     same way. */
  function hudSet(idxEl, nameEl, idx, animate) {
    if (!idxEl || !nameEl) return;
    idxEl.textContent = String(idx + 1).padStart(2, '0');
    nameEl.textContent = projects[idx].name;
    if (animate && !reduced) {
      nameEl.classList.remove('tick');
      void nameEl.offsetWidth;
      nameEl.classList.add('tick');
    }
  }
  var heroHudIdx = document.getElementById('heroHudIdx');
  var heroHudName = document.getElementById('heroHudName');
  var demoHudIdx = document.getElementById('demoHudIdx');
  var demoHudName = document.getElementById('demoHudName');

  function heroFocus(idx, animate) {
    heroIdx = idx;
    heroPanes.forEach(function (p, i) { p.classList.toggle('focused', i === idx); });
    heroPins.forEach(function (p, i) { p.classList.toggle('on', i === idx); });
    renderExplorer(heroXpl, idx, animate);
    hudSet(heroHudIdx, heroHudName, idx, animate);
    if (heroTraceReady) heroDrawTrace(idx, animate);
  }

  heroFocus(0, false);

  if (!reduced) {
    var startCycle = function () {
      if (heroTimer) return;
      // first activation: the assembly choreography is done by now, draw
      // the trace instantly instead of animating from a mid-flight pane
      if (!heroTraceReady) { heroTraceReady = true; heroDrawTrace(heroIdx, false); }
      heroTimer = setInterval(function () {
        heroFocus((heroIdx + 1) % 4, true);
      }, 3400);
    };
    var stopCycle = function () {
      if (heroTimer) { clearInterval(heroTimer); heroTimer = null; }
    };
    // wait for the assembly choreography before cycling
    setTimeout(function () {
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { e.isIntersecting ? startCycle() : stopCycle(); });
        }, { threshold: 0.25 }).observe(heroApp);
      } else {
        startCycle();
      }
    }, 2300);
  } else {
    heroTraceReady = true;
    heroDrawTrace(0, false);
  }

  /* ---- live demo: the visitor drives the focus ---- */
  var demoApp = document.getElementById('demoApp');
  var demoXpl = document.getElementById('demoXpl');
  var demoPanes = Array.prototype.slice.call(document.querySelectorAll('.dpane'));
  var demoPins = Array.prototype.slice.call(demoApp.querySelectorAll('.pin-btn'));
  var demoDrawTrace = makeTraceDrawer(
    demoApp.querySelector('.app-body'), demoPins, demoPanes,
    document.getElementById('demoTracePath'), document.getElementById('demoTracePad'),
    document.getElementById('demoTraceBase'), makeCometTrain(document.getElementById('demoTraceSparks'), traceCometOpts)
  );

  var demoCur = 0;
  /* 2026-08-14 fix: a genuinely fresh pane hover holds off scroll-driven
     scrubbing only for this short grace window, not indefinitely — see
     the .demo-stage comment above for why the old whole-window flag
     made scrolling feel dead. */
  var demoHoverUntil = 0;
  function demoFocus(idx) {
    demoCur = idx;
    demoPanes.forEach(function (p, i) { p.classList.toggle('focused', i === idx); });
    demoPins.forEach(function (p, i) {
      var on = i === idx;
      p.setAttribute('aria-pressed', String(on));
      var dot = p.querySelector('.pin');
      if (dot) dot.classList.toggle('on', on);
    });
    renderExplorer(demoXpl, idx, true);
    hudSet(demoHudIdx, demoHudName, idx, true);
    demoDrawTrace(idx, true);
  }

  demoPanes.forEach(function (p, i) {
    p.addEventListener('pointerenter', function () { demoHoverUntil = performance.now() + 600; demoFocus(i); });
    p.addEventListener('click', function () { demoFocus(i); });
    p.addEventListener('focus', function () { demoFocus(i); });
  });
  demoPins.forEach(function (p, i) {
    p.addEventListener('click', function () { demoFocus(i); });
  });
  demoDrawTrace(0, false);

  /* ---- chrome: scroll-spy nav readout ----
     Which section currently crosses the viewport-center band, mirrored
     into the HUD readout as an index + label. State changes are plain
     text/class toggles (fine under reduced motion). */
  var spyIds = ['crew', 'demo', 'oss', 'install'];
  var spyLabels = ['CREW', 'DEMO', 'OSS', 'INSTALL'];
  var spyTargets = spyIds.map(function (id) { return document.getElementById(id); });
  var navIdxEl = document.getElementById('navIdx');
  var navLabelEl = document.getElementById('navLabel');

  function navSpySet(idx) {
    if (idx < 0 || !navIdxEl || !navLabelEl) return;
    navIdxEl.textContent = String(idx + 1).padStart(2, '0');
    navLabelEl.textContent = spyLabels[idx];
    if (!reduced) {
      navIdxEl.classList.remove('tick');
      void navIdxEl.offsetWidth;
      navIdxEl.classList.add('tick');
    }
  }

  if ('IntersectionObserver' in window && spyTargets.length) {
    var spy = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) navSpySet(spyTargets.indexOf(e.target));
      });
    }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
    spyTargets.forEach(function (t) { if (t) spy.observe(t); });
  }

  /* ---- chrome: scroll reveal ----
     One shared observer drives every .reveal element (crew cards, tool
     wall, closer rows, oss cards, install CTA) plus every .kin heading
     (masked word-rise). Each element reveals once, then is unobserved —
     this is a one-time entrance, not a repeating effect on
     scroll-back-up. The hero h1 is kinetic too but part of the load
     choreography, so it fires immediately instead of waiting on the
     observer. */
  document.querySelectorAll('.wall span').forEach(function (el, i) {
    el.style.setProperty('--rd', (i * 0.045).toFixed(3) + 's');
  });
  var heroH1 = document.getElementById('heroH1');
  if (heroH1) heroH1.classList.add('in');
  var revealEls = Array.prototype.slice.call(document.querySelectorAll('.reveal, .kin'));
  if (revealEls.length) {
    if (reduced || !('IntersectionObserver' in window)) {
      revealEls.forEach(function (el) { el.classList.add('in'); });
    } else {
      var revealObs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); revealObs.unobserve(e.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      revealEls.forEach(function (el) { if (!el.classList.contains('in')) revealObs.observe(el); });
    }
  }

  /* ---- chrome: section-seam channel ----
     Static board-channel ornament: measure the big section tops once, run a
     vertical route down the left gutter that jogs sideways at every seam
     (same chamfered geometry as the focus trace), and leave it be. No
     focus semantics, no interaction, no scroll listener — redrawn only on
     load/resize because the section tops move with layout. */
  var seamPath = document.getElementById('seamPath');
  var seamBed = document.getElementById('seamBed');
  var seamLive = document.getElementById('seamLive');
  /* comet packets on the seam itself (2026-08-15, user: the left energy
     lane showed no motion at all) — the scroll-linked charge only ever
     moves while the visitor scrolls; the same makeCometTrain the mockup
     traces use gives the lane idle-state life. */
  var seamComet = makeCometTrain(document.getElementById('seamSparks'), seamCometOpts);
  /* via-pad blips: as a packet's head crosses a pad, the pad flashes
     cream and relaxes back through its own transition. Pad thresholds
     (seamViaMeta[].t) are Y-fractions of the route span; the route is
     near-vertical (the jogs are ~20px against thousands), so using them
     as arc fractions is the same approximation updateSeamCharge already
     leans on. prev>frac marks a new flight. */
  var seamBlipPrev = 1;
  function blipVia(el) {
    el.classList.add('blip');
    setTimeout(function () { el.classList.remove('blip'); }, 300);
  }
  seamCometOpts.onProgress = function (frac) {
    if (frac < seamBlipPrev) { seamBlipPrev = frac; return; }
    for (var j = 0; j < seamViaMeta.length; j++) {
      var t = seamViaMeta[j].t;
      if (t > seamBlipPrev && t <= frac) blipVia(seamViaMeta[j].el);
    }
    seamBlipPrev = frac;
  };
  var seamViaEls = Array.prototype.slice.call(document.querySelectorAll('.seam-svg rect.seam-via'));
  var seamStartY = 0, seamEndY = 0;
  var seamViaMeta = []; // { el, t } — t is this via's own scroll-fraction threshold
  var seamLegs = []; // { rect, len } — one per chamfered-line segment, built fresh on every drawSeam()
  var seamRawLen = 0; // sum of seamLegs[].len — the arc length the charge fraction below is measured against
  var seamActiveIdx = -1; // index of the one leg currently mid-charge — the only leg touched every frame

  function setLegScale(leg, frac) {
    leg.rect.style.transform = leg.rect.style.transform.replace(/scaleX\([^)]*\)/, 'scaleX(' + frac + ')');
  }

  function drawSeam() {
    if (!seamPath) return;
    var mainEl = document.getElementById('top');
    var stops = [
      document.getElementById('crew'),
      document.querySelector('.toolwall'),
      document.querySelector('section[aria-label="Details"]'),
      document.getElementById('oss'),
      document.getElementById('install')
    ];
    for (var s = 0; s < stops.length; s++) { if (!stops[s]) return; }
    var originTop = mainEl.getBoundingClientRect().top;
    var ys = stops.map(function (el) { return el.getBoundingClientRect().top - originTop; });
    /* 14/36 → gutter-adaptive (2026-08-15): paired with the wider
       .seam-svg CSS offset. On clamped mid-width viewports the CSS
       `max(6px, …)` floor eats the offset and the fixed route x-coords
       ended up hugging (or crossing) the content column — so the route
       measures the real gutter and slims itself to keep ≥20px of air to
       the content edge, narrowing the jog before giving up ground. */
    var wrapEl = document.querySelector('main .wrap');
    var svgLeft = seamPath.ownerSVGElement.getBoundingClientRect().left;
    var contentLeft = wrapEl ? wrapEl.getBoundingClientRect().left : 120;
    var maxX = contentLeft - svgLeft - 20;
    var xB = Math.max(12, Math.min(26, maxX));
    var xA = Math.max(4, xB - 18);
    var pts = [{ x: xA, y: ys[0] + 26 }];
    var viaPts = [{ x: xA, y: ys[0] + 26 }]; // one via per stop, plus the terminus below
    for (var i = 1; i < ys.length; i++) {
      var jogX = (i % 2) ? xA : xB, contX = (i % 2) ? xB : xA;
      pts.push({ x: jogX, y: ys[i] });
      viaPts.push({ x: jogX, y: ys[i] });
      pts.push({ x: contX, y: ys[i] });
    }
    var lastX = pts[pts.length - 1].x, termY = ys[ys.length - 1] + 64;
    pts.push({ x: lastX, y: termY });
    viaPts.push({ x: lastX, y: termY });
    var line = simplifyPoints(pts);
    var d = pathD(line, 6);
    seamPath.setAttribute('d', d);
    if (seamBed) seamBed.setAttribute('d', d);
    if (seamComet) seamComet.update(line, 6);

    // rebuild the live-charge rect pool from the SAME chamfered-line
    // segments #seamPath itself is drawn from (chamferedLine(line, 6)) —
    // matching geometry, including the 45° corner chamfers, so "charged"
    // reads as solid-over-dashed with no corner misregistration. Every
    // segment (straight run or diagonal chamfer alike) becomes one
    // 2px-tall rect starting at local (0,0), oriented via `rotate` — a
    // single formula for every angle instead of separate vertical/
    // horizontal branches (which had a bug: the old vertical branch set
    // both the rect's own `x` attribute AND an `x` translate, doubling
    // the offset).
    if (seamLive) {
      seamLive.textContent = '';
      seamLegs = [];
      seamRawLen = 0;
      var chLine = chamferedLine(line, 6);
      for (var p = 1; p < chLine.length; p++) {
        var A = chLine[p - 1], B = chLine[p];
        var legLen = Math.hypot(B.x - A.x, B.y - A.y);
        var angleDeg = Math.atan2(B.y - A.y, B.x - A.x) * 180 / Math.PI;
        var rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        rect.setAttribute('x', '0');
        rect.setAttribute('y', '-1');
        rect.setAttribute('width', String(legLen));
        rect.setAttribute('height', '2');
        rect.style.transformBox = 'view-box';
        rect.style.transformOrigin = '0px 0px';
        rect.style.transform =
          'translate(' + A.x.toFixed(2) + 'px,' + A.y.toFixed(2) + 'px) rotate(' + angleDeg.toFixed(3) + 'deg) scaleX(0)';
        seamLive.appendChild(rect);
        seamLegs.push({ rect: rect, len: legLen });
        seamRawLen += legLen;
      }
      seamActiveIdx = -1; // force a full boundary re-commit on the next updateSeamCharge()
    }

    // cache the route's own absolute document-Y range for the
    // scroll-linked charge below — mapped against the route's own span,
    // not scrollY/documentHeight, or the route would already read "full"
    // somewhere in the footer, well past its own last via.
    var mainTopAbs = originTop + window.scrollY;
    seamStartY = mainTopAbs + viaPts[0].y;
    seamEndY = mainTopAbs + viaPts[viaPts.length - 1].y;

    // latching via pads: each one's own threshold is its own Y position
    // within the route's span, so it flips to filled exactly when the
    // charge visually reaches it.
    seamViaMeta = [];
    for (var v = 0; v < seamViaEls.length && v < viaPts.length; v++) {
      var el = seamViaEls[v];
      el.setAttribute('x', String(viaPts[v].x - 3.5));
      el.setAttribute('y', String(viaPts[v].y - 3.5));
      var viaAbsY = mainTopAbs + viaPts[v].y;
      var vt = (seamEndY > seamStartY) ? (viaAbsY - seamStartY) / (seamEndY - seamStartY) : 0;
      seamViaMeta.push({ el: el, t: vt });
    }
  }

  drawSeam();
  window.addEventListener('load', drawSeam);

  /* ---- chrome: seam charge (scroll-linked) ----
     A row of solid rects on the seam's identical geometry "power up" as
     the visitor scrolls through its own Y-range — the dashed #seamPath
     channel is untouched, this is purely an overlay — plus each via pad
     latches from outline to filled once the charge reaches its own Y, the
     functional "where am I" readout the nav used to attempt with a
     capsule of loose dots. Reads only window.scrollY here (no
     getBoundingClientRect) to avoid layout thrashing; called from the
     shared, rAF-gated scroll ticker below (performance-audit ticket 15) —
     no rAF gate of its own anymore. */
  var navPct = document.getElementById('navPct');
  var navPctWrap = document.getElementById('navPctWrap');
  if (reduced && navPctWrap) navPctWrap.style.display = 'none';
  function updateSeamCharge() {
    if (!seamRawLen || seamEndY <= seamStartY) return;
    var t = (window.scrollY - seamStartY) / (seamEndY - seamStartY);
    if (t < 0) t = 0; if (t > 1) t = 1;
    // same mapping the old stroke-dashoffset used: t (a Y-position
    // fraction) reused directly as the fraction of the route's own ARC
    // length that's charged, walked from the route's start. Only the one
    // leg the charge is currently inside gets a transform write every
    // frame; legs the charge has already fully passed or hasn't reached
    // yet only get (re-)committed to scale 1/0 on the rare frame where
    // the active leg itself changes — not on every scroll tick.
    var target = t * seamRawLen;
    var walked = 0;
    var activeIdx = seamLegs.length - 1;
    for (var i = 0; i < seamLegs.length; i++) {
      var legEnd = walked + seamLegs[i].len;
      if (target <= legEnd || i === seamLegs.length - 1) { activeIdx = i; break; }
      walked += seamLegs[i].len;
    }
    var activeLeg = seamLegs[activeIdx];
    var activeFrac = activeLeg && activeLeg.len > 0 ? (target - walked) / activeLeg.len : 1;
    if (activeFrac < 0) activeFrac = 0; if (activeFrac > 1) activeFrac = 1;
    if (activeLeg) setLegScale(activeLeg, activeFrac);
    if (activeIdx !== seamActiveIdx) {
      for (var k = 0; k < seamLegs.length; k++) {
        if (k < activeIdx) setLegScale(seamLegs[k], 1);
        else if (k > activeIdx) setLegScale(seamLegs[k], 0);
      }
      seamActiveIdx = activeIdx;
    }
    for (var j = 0; j < seamViaMeta.length; j++) {
      seamViaMeta[j].el.classList.toggle('charged', t >= seamViaMeta[j].t);
    }
    // route-progress percent in the nav readout — same t as the seam
    // charge, so both instruments always agree on "how far in are we".
    if (navPct && !reduced) navPct.textContent = String(Math.round(t * 100)).padStart(3, '0') + '%';
  }
  /* ---- chrome: bokeh parallax (hero only) ----
     The whole .bokeh layer drifts at a fraction of scroll speed — never
     its individual blur()'d children, which would re-rasterize the blur
     every frame. Stops reading scroll once the hero has scrolled past;
     the clouds are hero-local atmosphere, not a page-wide effect. */
  var bokeh = document.querySelector('.bokeh');
  var heroBottom = heroApp ? heroApp.getBoundingClientRect().bottom + window.scrollY + 200 : 900;
  if (bokeh && !reduced) bokeh.style.willChange = 'transform';
  function updateBokeh() {
    if (!bokeh || window.scrollY > heroBottom) return;
    bokeh.style.transform = 'translateY(' + (window.scrollY * 0.08).toFixed(1) + 'px)';
  }

  /* ---- cinematic layer: scroll-linked depth + pinned demo scrub + cue ----
     — updateVfx: every [data-vfx] element gets a transform from its offset
       to viewport center — "par" layers drift at depth-dependent speed,
       "tilt" layers pitch slightly in perspective and settle flat at
       center stage. Transform-only, offscreen elements skipped.
     — updateDemoScrub: while the demo stage is pinned (CSS above), scroll
       progress through the stage steps focus across the four panes — the
       explorer-follows story told by the scroll itself. The pointer wins
       while it's inside the demo window.
     — the hero scroll cue fades once scrolling starts.
     Desktop + motion-preference only; disabled state clears its own
     transforms so a resize across the breakpoint can't strand one. */
  var vfxEls = Array.prototype.slice.call(document.querySelectorAll('[data-vfx]'));
  var demoStage = document.getElementById('demo');
  var demoProgress = document.getElementById('demoProgress');
  var scrollCue = document.getElementById('scrollCue');
  var fxWide = matchMedia('(min-width: 941px)').matches;

  /* will-change scoping (performance-audit ticket 15): .vfx-inview (see
     CSS above) is only present while an element is actually visible or
     about to be — a 200px rootMargin, more generous than updateVfx's own
     120px write-skip window above, so the compositor layer is already
     promoted before the first transform write and doesn't get dropped
     right before the last one. */
  if (!reduced && 'IntersectionObserver' in window && vfxEls.length) {
    var vfxVisibility = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        e.target.classList.toggle('vfx-inview', e.isIntersecting);
      });
    }, { rootMargin: '200px 0px' });
    vfxEls.forEach(function (el) { vfxVisibility.observe(el); });
  }

  function updateVfx() {
    if (!fxWide) return;
    var vh = window.innerHeight, cy = vh / 2;
    vfxEls.forEach(function (el) {
      var r = el.getBoundingClientRect();
      if (r.bottom < -120 || r.top > vh + 120) return;
      var t = ((r.top + r.height / 2) - cy) / vh;
      if (t < -1) t = -1; if (t > 1) t = 1;
      if (el.getAttribute('data-vfx') === 'tilt') {
        var deg = parseFloat(el.getAttribute('data-tilt-max') || '4');
        el.style.transform = 'perspective(1100px) rotateX(' + (t * deg).toFixed(2) + 'deg)';
      } else {
        var par = parseFloat(el.getAttribute('data-par') || '20');
        el.style.transform = 'translateY(' + (t * par).toFixed(1) + 'px)';
      }
    });
  }

  function updateDemoScrub() {
    if (!fxWide || !demoStage) return;
    var r = demoStage.getBoundingClientRect();
    var span = r.height - window.innerHeight;
    if (span < 120) return; // stage isn't pinned at this size
    var p = -r.top / span;
    if (p < 0) p = 0; if (p > 1) p = 1;
    if (demoProgress) demoProgress.style.width = (p * 100).toFixed(1) + '%';
    if (performance.now() < demoHoverUntil) return; // let a just-hovered pane stand briefly
    var idx = Math.min(3, Math.floor(p * 4));
    if (idx !== demoCur) demoFocus(idx);
  }

  function updateCue() {
    if (scrollCue) scrollCue.classList.toggle('gone', window.scrollY > 60);
  }

  /* ---- shared scroll ticker (performance-audit ticket 15) ----
     The seam-charge, bokeh-parallax, and vfx/demo-scrub/cue effects above
     used to run on three independent `scroll` listeners, each gated by
     its own rAF "ticking" boolean — up to three separate scroll-event
     dispatches and up to three separate rAF callbacks queued per actual
     repaint opportunity. Consolidated into one listener + one rAF gate;
     update order below (seam, bokeh, vfx, demo-scrub, cue) matches the
     order the three independent listeners already ran in relative to
     each other. Initial-call semantics are preserved exactly as before:
     updateSeamCharge() always ran once regardless of motion preference
     (kept unconditional, below), bokeh never got an initial call outside
     a scroll event, and vfx/demoScrub/cue only ran their first pass when
     motion is not reduced (mirrors the old fxFrame() initial call). */
  if (!reduced) {
    var scrollTicking = false;
    var scrollFrame = function () {
      scrollTicking = false;
      updateSeamCharge();
      updateBokeh();
      updateVfx();
      updateDemoScrub();
      updateCue();
    };
    window.addEventListener('scroll', function () {
      if (!scrollTicking) { scrollTicking = true; requestAnimationFrame(scrollFrame); }
    }, { passive: true });
    updateVfx();
    updateDemoScrub();
    updateCue();
  }
  updateSeamCharge();

  /* ---- install: the brew command types itself, once ----
     The one deliberate typing moment on the page (kinetic-type scope,
     2026-08-14 Auftrag) — it's a terminal command in a terminal-shaped
     pill, typed the way you'd actually enter it. Width is frozen first so
     the pill doesn't grow mid-type; reduced-motion/no-JS keep the full
     static text. */
  var brewCmd = document.getElementById('brewCmd');
  var installSec = document.getElementById('install');
  if (brewCmd && installSec && !reduced && 'IntersectionObserver' in window) {
    var brewTyped = false;
    var brewObs = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting || brewTyped) return;
        brewTyped = true;
        brewObs.disconnect();
        var full = brewCmd.textContent;
        brewCmd.style.display = 'inline-block';
        brewCmd.style.minWidth = brewCmd.getBoundingClientRect().width + 'px';
        brewCmd.style.textAlign = 'left';
        var pos = 0;
        brewCmd.textContent = '';
        var caret = document.createElement('span');
        caret.className = 'cursor';
        brewCmd.appendChild(caret);
        var timer = setInterval(function () {
          pos++;
          brewCmd.textContent = full.slice(0, pos);
          if (pos >= full.length) { clearInterval(timer); return; }
          brewCmd.appendChild(caret);
        }, 34);
      });
    }, { threshold: 0.45 });
    brewObs.observe(installSec);
  }

  var resizeTimer = null;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      if (heroTraceReady) heroDrawTrace(heroIdx, false);
      var demoFocusedIdx = demoPanes.findIndex(function (p) { return p.classList.contains('focused'); });
      demoDrawTrace(demoFocusedIdx < 0 ? 0 : demoFocusedIdx, false);
      drawSeam();
      updateSeamCharge();
      var nowWide = matchMedia('(min-width: 941px)').matches;
      if (nowWide !== fxWide) {
        fxWide = nowWide;
        if (!fxWide) vfxEls.forEach(function (el) { el.style.transform = ''; });
      }
      if (!reduced) { updateVfx(); updateDemoScrub(); }
    }, 120);
  });
})();
</script>
</body>
</html>
