---
// PaneCrew marketing landing page — Prototype 6 "Charmline".
// Direction contract: ../../../.impeccable/direction-contract-website.md
// Ported verbatim from the approved artifact prototype; keep this
// page's structure/copy/behavior in sync with that contract, not with
// apps/desktop's own "no-glow"/theming rules (the website has its own).
const siteUrl = "https://panecrew.dev";
const title = "PaneCrew — A pane for every agent";
const description =
  "Run multiple CLI coding agent sessions — Claude Code, Codex, Gemini CLI — in one terminal grid, with a focus-following file explorer. Free & open source."; // brandlint-ok: functional product claim (tool-agnostic support), shown verbatim in <meta description>
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={siteUrl}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={siteUrl}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta property="og:image" content={`${siteUrl}/og-image.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:image" content={`${siteUrl}/og-image.png`}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" href="/favicon.png">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "PaneCrew",
      "url": "https://panecrew.dev",
      "logo": "https://panecrew.dev/favicon.png"
    },
    {
      "@type": "WebSite",
      "name": "PaneCrew",
      "url": "https://panecrew.dev"
    },
    {
      "@type": "SoftwareApplication",
      "name": "PaneCrew",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Windows",
      "description": "A grid of real, simultaneously visible terminal sessions across different projects, with a focus-following file explorer. Tool-agnostic: hosts any CLI coding agent.",
      "url": "https://panecrew.dev",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "license": "https://opensource.org/licenses/MIT"
    }
  ]
}
</script>
<style is:global>
  /* ============================================================
     PaneCrew landing prototype 6 — "Charmline"
     Warm, structured landing-page DNA translated into PaneCrew's
     indigo/amber/cyan/cream world. 25% Assembly DNA (pane fly-in,
     explorer dock, calm narration). 5% new: a hands-on
     focus-follow demo the visitor drives themselves.
     Self-contained, system fonts only.
     ============================================================ */
  :root {
    /* saturated indigo brand ground (from the icon world, #1F243C ref) */
    --indigo-hi: #333c72;
    --indigo: #262d58;
    --indigo-deep: #1f2547;
    --line-dark: rgba(255, 253, 245, 0.12);
    /* terminal interiors */
    --term: #12162a;
    --term-bar: #1b2038;
    --term-line: rgba(255, 253, 245, 0.09);
    /* cream product surfaces */
    --cream: #fffdf5;
    --cream-2: #f8f3e4;
    --ink: #23283f;
    --ink-dim: #5b5f75;
    /* amber brand accent */
    --amber: #e59656;
    --amber-deep: #b95f10;
    --amber-text: #c9741f;
    /* cyan second accent (explorer / follow) */
    --cyan: #29a9ac;
    --cyan-bright: #5acfd3;
    /* ANSI as real content */
    --ansi-green: #7ccb6e;
    --ansi-yellow: #e5c07b;
    --ansi-blue: #6ea8dc;
    /* type */
    --display: "Arial Rounded MT Bold", "SF Pro Rounded", ui-rounded, "Segoe UI", system-ui, sans-serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, "Cascadia Code", Consolas, monospace;
    --lift: 0.15s ease;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background:
      linear-gradient(180deg, var(--indigo-hi) 0%, var(--indigo) 16%, var(--indigo) 62%, #2a325f 88%, var(--indigo-hi) 100%);
    background-color: var(--indigo);
    color: var(--cream);
    font-family: var(--sans); font-size: 16.5px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  ::selection { background: rgba(229, 150, 86, 0.4); }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }
  img, svg { max-width: 100%; }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 26px; }

  /* ---------- eyebrow ornament (terminal-true ASCII corners) ---------- */
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--amber);
    display: flex; align-items: center; justify-content: center; gap: 10px;
    margin-bottom: 14px;
  }
  .eyebrow::before { content: "╭──"; letter-spacing: 0; color: rgba(229, 150, 86, 0.55); }
  .eyebrow::after { content: "──╮"; letter-spacing: 0; color: rgba(229, 150, 86, 0.55); }
  .eyebrow.left { justify-content: flex-start; }

  /* ---------- nav ---------- */
  .nav {
    position: relative; z-index: 20;
    display: flex; align-items: center; gap: 26px;
    max-width: 1120px; margin: 0 auto; padding: 20px 26px;
  }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo svg { width: 26px; height: 26px; }
  .logo b {
    font-family: var(--display); font-weight: 700; font-size: 21px; letter-spacing: -0.01em;
  }
  .nav-links { display: flex; gap: 22px; margin-left: 8px; }
  .nav-links a {
    text-decoration: none; font-size: 14.5px; color: rgba(255, 253, 245, 0.82);
    transition: color var(--lift);
  }
  .nav-links a:hover { color: var(--cream); }
  .nav-end { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .nav-cta {
    text-decoration: none;
    font-family: var(--mono); font-size: 13px;
    background: rgba(255, 253, 245, 0.1); border: 1px solid var(--line-dark);
    border-radius: 999px; padding: 7px 16px;
    transition: transform var(--lift), background var(--lift);
  }
  .nav-cta:hover { transform: translateY(-2px); background: rgba(255, 253, 245, 0.16); }
  .nav-gh {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px;
    background: rgba(255, 253, 245, 0.1); border: 1px solid var(--line-dark);
    border-radius: 999px; color: var(--cream); text-decoration: none;
    transition: transform var(--lift), background var(--lift), border-color var(--lift);
  }
  .nav-gh svg { width: 17px; height: 17px; }
  .nav-gh:hover { transform: translateY(-2px); background: rgba(255, 253, 245, 0.16); border-color: rgba(255, 253, 245, 0.3); }

  /* ---------- hero with bokeh clouds ---------- */
  .hero { position: relative; padding: 40px 0 110px; }
  .bokeh { position: absolute; inset: -120px 0 auto 0; height: 640px; pointer-events: none; overflow: hidden; }
  .bokeh i {
    position: absolute; border-radius: 50%; filter: blur(52px);
  }
  .bokeh .b1 { width: 480px; height: 420px; left: -140px; top: -60px; background: rgba(252, 173, 67, 0.34); }
  .bokeh .b2 { width: 560px; height: 460px; right: -160px; top: -120px; background: rgba(90, 207, 211, 0.22); }
  .bokeh .b3 { width: 420px; height: 380px; left: 30%; top: -180px; background: rgba(255, 243, 222, 0.15); }
  .bokeh .b4 { width: 320px; height: 300px; right: 22%; top: 60px; background: rgba(252, 173, 67, 0.16); }
  .spark {
    position: absolute; font-size: 20px; color: #ffe9c8;
    text-shadow: 0 0 0 transparent; opacity: 0.9; pointer-events: none;
    animation: twinkle 5s ease-in-out infinite;
  }
  @keyframes twinkle { 0%, 100% { opacity: 0.35; transform: scale(0.85); } 50% { opacity: 0.95; transform: scale(1); } }

  .hero-grid {
    position: relative; z-index: 2;
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 54px; align-items: center;
    padding-top: 44px;
  }
  .hero-copy .pills { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .tag {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    background: rgba(255, 253, 245, 0.1); border: 1px solid var(--line-dark);
    color: rgba(255, 253, 245, 0.85);
    border-radius: 999px; padding: 4px 12px;
  }
  .hero-copy h1 {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(42px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -0.015em;
    margin-bottom: 20px; text-wrap: balance;
  }
  .hero-copy h1 .am {
    background: linear-gradient(115deg, #fef2de 0%, #ffd394 52%, #fcad43 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-copy p { color: rgba(255, 253, 245, 0.85); max-width: 460px; margin-bottom: 12px; text-wrap: pretty; }
  .hero-copy .avail { font-size: 13.5px; color: rgba(255, 253, 245, 0.6); margin-bottom: 26px; }
  .btn {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--display); font-weight: 700; font-size: 16px;
    background: linear-gradient(180deg, #ffd394, #fcad43);
    color: #3a2405; text-decoration: none;
    border-radius: 999px; padding: 12px 26px;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.28);
    transition: transform var(--lift), box-shadow var(--lift);
  }
  .btn:hover { transform: translateY(-3px); box-shadow: 0 7px 0 rgba(0, 0, 0, 0.28); }
  .btn.ghost {
    background: transparent; color: var(--cream);
    border: 1px solid var(--line-dark); box-shadow: none;
  }
  .btn.ghost:hover { border-color: rgba(255, 253, 245, 0.4); }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ---------- the app window (assembly stage) ---------- */
  .app {
    background: var(--indigo-deep);
    border: 1px solid rgba(255, 253, 245, 0.14);
    border-radius: 14px; overflow: hidden;
    box-shadow: 0 30px 70px rgba(10, 12, 26, 0.55);
  }
  .app-bar {
    display: flex; align-items: center; gap: 7px;
    height: 34px; padding: 0 12px;
    background: rgba(255, 253, 245, 0.05);
    border-bottom: 1px solid var(--line-dark);
  }
  .tl { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
  .tl.r { background: #e0655f; } .tl.y { background: #e8bf5a; } .tl.g { background: #6cc26a; }
  .app-bar svg { width: 15px; height: 15px; margin-left: 8px; }
  .app-bar span { font-family: var(--mono); font-size: 11px; color: rgba(255, 253, 245, 0.55); }
  .app-body {
    display: grid; grid-template-columns: 30% 1fr; gap: 7px;
    padding: 8px; height: 350px;
  }

  .xpl {
    background: rgba(255, 253, 245, 0.05);
    border: 1px solid var(--term-line); border-radius: 8px;
    font-family: var(--mono); font-size: 11px; line-height: 1.95;
    color: rgba(255, 253, 245, 0.68);
    padding: 10px 0; overflow: hidden;
  }
  .xpl .hd {
    font-size: 8.5px; letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--cyan-bright); padding: 0 12px 5px; line-height: 1.6;
  }
  .xpl .proj { color: var(--amber); font-weight: 700; padding: 0 12px; white-space: nowrap; }
  .xpl ul { list-style: none; }
  .xpl li { padding: 0 12px 0 22px; white-space: nowrap; }
  .xpl li.hl { background: rgba(90, 207, 211, 0.14); color: var(--cream); }
  .xpl.swap { animation: xswap 0.28s ease; }
  @keyframes xswap { 0% { opacity: 0.25; transform: translateX(-5px); } 100% { opacity: 1; transform: none; } }

  .field { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 7px; }
  .hpane {
    background: var(--term); border: 1px solid var(--term-line); border-radius: 8px;
    font-family: var(--mono); font-size: 10.5px; line-height: 1.8;
    color: rgba(255, 253, 245, 0.62);
    padding: 28px 10px 6px; overflow: hidden; position: relative;
    transition: border-color 0.2s ease;
  }
  .hpane::before {
    content: attr(data-title);
    position: absolute; top: 0; left: 0; right: 0; height: 22px;
    display: flex; align-items: center; padding: 0 10px;
    background: var(--term-bar); border-bottom: 1px solid var(--term-line);
    color: rgba(255, 253, 245, 0.45); font-size: 9.5px; white-space: nowrap;
  }
  .hpane.focused { border-color: var(--amber); }
  .hpane.focused::before { color: var(--amber); }
  .g { color: var(--ansi-green); } .y { color: var(--ansi-yellow); }
  .c { color: var(--cyan-bright); } .b { color: var(--ansi-blue); }
  .w { color: var(--cream); }
  .cursor {
    display: inline-block; width: 6px; height: 11px; vertical-align: -2px;
    background: var(--amber); animation: blink 1.06s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* assembly fly-in (load choreography, hero only) */
  .assemble .hpane {
    animation: flyin 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--fd, 0.1s);
  }
  .assemble .xpl {
    animation: dockin 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: 1.15s;
  }
  @keyframes flyin {
    from { transform: translate(var(--fx, -40%), var(--fy, -60%)) rotate(var(--fr, -8deg)) scale(0.82); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  @keyframes dockin {
    from { transform: translateX(-120%); opacity: 0; }
    to { transform: none; opacity: 1; }
  }

  /* ---------- section headers ---------- */
  .sect-head { text-align: center; padding: 96px 26px 46px; }
  .sect-head h2 {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(34px, 4.6vw, 54px); letter-spacing: -0.015em; line-height: 1.05;
    text-wrap: balance;
  }
  .sect-head p { color: rgba(255, 253, 245, 0.75); max-width: 560px; margin: 14px auto 0; text-wrap: pretty; }

  /* ---------- crew cards (card gallery) ---------- */
  .crew-row {
    display: grid; grid-template-columns: 3fr 2fr; gap: 24px;
    margin-bottom: 24px;
  }
  .crew-row.rev { grid-template-columns: 2fr 3fr; }
  .card {
    background: var(--cream); color: var(--ink);
    border-radius: 16px; overflow: hidden;
    display: flex; flex-direction: column;
    box-shadow: 0 10px 26px rgba(10, 12, 26, 0.3);
    transition: transform var(--lift), box-shadow var(--lift);
  }
  .card:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(10, 12, 26, 0.38); }
  .card-vis {
    margin: 12px 12px 0; border-radius: 10px;
    background: var(--term); border: 1px solid rgba(255, 253, 245, 0.06);
    min-height: 168px; position: relative; overflow: hidden;
    display: flex; align-items: stretch;
  }
  .card-body { padding: 16px 20px 20px; }
  .sticker {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(26px, 2.6vw, 32px); letter-spacing: -0.01em; line-height: 1.1;
    color: var(--amber-text);
    display: inline-block; margin-bottom: 8px;
  }
  .card .pills { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.07em; text-transform: uppercase;
    background: #f6ead4; border: 1px solid #e8cfa4; color: #8a5a1a;
    border-radius: 999px; padding: 3px 10px;
  }
  .badge svg { width: 10px; height: 10px; flex: none; }
  .badge.cy { background: #ddf2f2; border-color: #a8dcdc; color: #17696b; }
  .card p { font-size: 14.5px; color: var(--ink-dim); text-wrap: pretty; }
  .card .more { display: inline-block; margin-top: 8px; font-size: 13.5px; font-weight: 600; color: var(--amber-text); text-decoration: none; }
  .card .more:hover { text-decoration: underline; }

  /* card visuals: small terminal mocks */
  .mock {
    font-family: var(--mono); font-size: 11px; line-height: 1.85;
    color: rgba(255, 253, 245, 0.62); padding: 30px 14px 10px; width: 100%;
    position: relative;
  }
  .mock::before {
    content: attr(data-title);
    position: absolute; top: 0; left: 0; right: 0; height: 24px;
    display: flex; align-items: center; padding: 0 12px;
    background: var(--term-bar); border-bottom: 1px solid var(--term-line);
    color: rgba(255, 253, 245, 0.45); font-size: 10px;
  }
  .minigrid {
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;
    gap: 6px; padding: 10px; width: 100%;
  }
  .minigrid .mp {
    background: rgba(255, 253, 245, 0.045); border: 1px solid var(--term-line);
    border-radius: 6px; padding: 6px 8px;
    font-family: var(--mono); font-size: 9.5px; line-height: 1.7;
    color: rgba(255, 253, 245, 0.55); overflow: hidden; white-space: nowrap;
  }
  .minigrid .mp b { display: block; font-weight: 400; color: rgba(255, 253, 245, 0.4); font-size: 8.5px; margin-bottom: 2px; }
  .minigrid .mp.amb { border-color: rgba(229, 150, 86, 0.65); }
  .tabsvis { padding: 12px; width: 100%; display: flex; flex-direction: column; gap: 0; }
  .tabrow { display: flex; gap: 4px; }
  .tab {
    font-family: var(--mono); font-size: 10px; padding: 5px 12px;
    border: 1px solid var(--term-line); border-bottom: none;
    border-radius: 7px 7px 0 0; color: rgba(255, 253, 245, 0.45);
  }
  .tab.on { background: rgba(255, 253, 245, 0.07); color: var(--amber); border-color: rgba(229, 150, 86, 0.5); }
  .tabpane {
    border: 1px solid var(--term-line); border-radius: 0 7px 7px 7px;
    background: rgba(255, 253, 245, 0.03); flex: 1; padding: 8px 10px;
    font-family: var(--mono); font-size: 10px; line-height: 1.8; color: rgba(255, 253, 245, 0.6);
  }
  .swatches { display: flex; gap: 8px; padding: 8px 12px 0; }
  .sw { width: 26px; height: 26px; border-radius: 7px; border: 1px solid rgba(255, 253, 245, 0.2); }

  /* ---------- tool wall (honest "industrial grade" slot) ---------- */
  .toolwall { text-align: center; padding: 30px 26px 10px; }
  .wall {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline;
    gap: 20px 38px; max-width: 980px; margin: 30px auto 0;
  }
  .wall span {
    display: inline-flex; align-items: center; gap: 9px;
    color: rgba(255, 253, 245, 0.9); white-space: nowrap;
  }
  .wall .ic { flex: none; fill: currentColor; }
  .wall .lg { font-family: var(--display); font-weight: 700; font-size: 25px; letter-spacing: -0.01em; }
  .wall .lg .ic { width: 27px; height: 27px; }
  .wall .md { font-family: var(--mono); font-size: 17px; opacity: 0.8; }
  .wall .md .ic { width: 20px; height: 20px; }
  .wall .sm { font-family: var(--mono); font-size: 14px; opacity: 0.6; }
  .wall .sm .ic { width: 16px; height: 16px; }
  .toolwall .kicker {
    margin-top: 34px; font-family: var(--mono); font-size: 13px; color: var(--amber);
  }

  /* ---------- look closer (alternating rows) ---------- */
  .closer-row {
    display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 50px; align-items: center;
    margin-bottom: 90px;
  }
  .closer-row.rev { grid-template-columns: 0.85fr 1.15fr; }
  .closer-row.rev .closer-vis { order: 2; }
  .closer-copy h3 {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(28px, 3.2vw, 40px); letter-spacing: -0.015em; line-height: 1.08;
    margin-bottom: 14px;
    color: var(--amber);
  }
  .closer-copy p { color: rgba(255, 253, 245, 0.8); text-wrap: pretty; margin-bottom: 10px; }
  .closer-copy .hint { font-family: var(--mono); font-size: 12.5px; color: var(--cyan-bright); }

  /* the live demo (the 5% novelty) */
  .demo {
    background: var(--indigo-deep);
    border: 1px solid rgba(255, 253, 245, 0.14); border-radius: 14px;
    box-shadow: 0 24px 60px rgba(10, 12, 26, 0.5);
    overflow: hidden;
  }
  .demo .app-body { height: 330px; }
  .dpane {
    all: unset; display: block; cursor: pointer;
    background: var(--term); border: 1px solid var(--term-line); border-radius: 8px;
    font-family: var(--mono); font-size: 10.5px; line-height: 1.8;
    color: rgba(255, 253, 245, 0.62);
    padding: 28px 10px 6px; overflow: hidden; position: relative;
    transition: border-color 0.2s ease, transform var(--lift);
    box-sizing: border-box; width: 100%; height: 100%;
  }
  .dpane::before {
    content: attr(data-title);
    position: absolute; top: 0; left: 0; right: 0; height: 22px;
    display: flex; align-items: center; padding: 0 10px;
    background: var(--term-bar); border-bottom: 1px solid var(--term-line);
    color: rgba(255, 253, 245, 0.45); font-size: 9.5px; white-space: nowrap;
  }
  .dpane:hover { transform: translateY(-1px); }
  .dpane:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }
  .dpane.focused { border-color: var(--amber); }
  .dpane.focused::before { color: var(--amber); }

  /* ---------- open source ("we love open source" slot, honest version) ---------- */
  .oss-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .oss-grid .card-vis { min-height: 132px; }
  .heart {
    background: linear-gradient(115deg, #fef2de 0%, #ffd394 52%, #fcad43 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  @media (max-width: 940px) {
    .oss-grid { grid-template-columns: 1fr; }
  }

  /* ---------- install CTA ---------- */
  .install { text-align: center; padding: 40px 26px 140px; position: relative; }
  .install h2 {
    font-family: var(--display); font-weight: 700;
    font-size: clamp(34px, 4.6vw, 54px); letter-spacing: -0.015em; margin-bottom: 14px; text-wrap: balance;
  }
  .install p { color: rgba(255, 253, 245, 0.75); margin-bottom: 30px; max-width: 520px; margin-left: auto; margin-right: auto; text-wrap: pretty; }
  .brew {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--mono); font-size: 15px;
    background: rgba(18, 22, 42, 0.75); border: 1px solid rgba(229, 150, 86, 0.5);
    color: var(--cream); border-radius: 999px; padding: 14px 26px;
    transition: transform var(--lift), border-color var(--lift);
  }
  .brew:hover { transform: translateY(-2px); border-color: var(--amber); }
  .brew .soon {
    color: var(--amber); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .install-ctas { display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; }

  /* ---------- wave + cream footer ---------- */
  .wave { display: block; width: 100%; height: 80px; margin-bottom: -1px; }
  footer { background: var(--cream); color: var(--ink); padding: 40px 0 54px; }
  .foot {
    max-width: 1120px; margin: 0 auto; padding: 0 26px;
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  }
  .glyph-tile {
    width: 34px; height: 34px; border-radius: 9px;
    background: #1f243c; display: flex; align-items: center; justify-content: center;
    flex: none;
  }
  .glyph-tile svg { width: 21px; height: 21px; }
  .foot b { font-family: var(--display); font-weight: 700; font-size: 17px; }
  .foot .cp { color: var(--ink-dim); font-size: 13.5px; }
  .foot .r { margin-left: auto; font-family: var(--mono); font-size: 12px; color: var(--ink-dim); }
  .foot-gh {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; flex: none;
    border: 1px solid rgba(35, 40, 63, 0.14); border-radius: 999px;
    color: var(--ink); text-decoration: none;
    transition: background var(--lift), border-color var(--lift), transform var(--lift);
  }
  .foot-gh svg { width: 16px; height: 16px; }
  .foot-gh:hover { background: rgba(35, 40, 63, 0.06); border-color: rgba(35, 40, 63, 0.26); transform: translateY(-2px); }

  /* ---------- reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .cursor, .spark { animation: none; }
    .assemble .hpane, .assemble .xpl { animation: none; }
    .xpl.swap { animation: none; }
    .card:hover, .btn:hover, .brew:hover, .nav-cta:hover, .dpane:hover { transform: none; }
  }

  /* ---------- responsive ---------- */
  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-copy { order: -1; text-align: center; }
    .hero-copy .pills, .hero-ctas { justify-content: center; }
    .hero-copy p { margin-left: auto; margin-right: auto; }
    .crew-row, .crew-row.rev { grid-template-columns: 1fr; }
    .closer-row, .closer-row.rev { grid-template-columns: 1fr; gap: 26px; }
    .closer-row.rev .closer-vis { order: 0; }
  }
  @media (max-width: 560px) {
    .nav-links { display: none; }
    .app-body { grid-template-columns: 1fr; height: auto; }
    .xpl { display: none; }
    .demo .app-body { height: auto; grid-template-columns: 1fr; }
    .demo .xpl { display: block; }
    .field { grid-template-rows: none; }
    .hpane, .dpane { min-height: 110px; }
    .demo .field { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
