---
// Shared chrome for the /docs/* reference section. Same head/nav/footer
// markup and tokens as GuideLayout.astro (site-chrome.css) — kept as its
// own file rather than wrapped around GuideLayout because this layout adds
// a section sidebar GuideLayout has no slot for; GuideLayout was built for
// a single long article and intentionally has no doc-tree nav. Duplicating
// the head/nav/footer markup instead of abstracting it out matches the
// existing split between index.astro and GuideLayout.astro (see that
// file's header comment) — only the CSS is shared, not the markup.
import "../styles/site-chrome.css";

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/docs/install/"
  active: string; // nav item id to highlight, see navItems below
}
const { title, description, path, active } = Astro.props;
const siteUrl = "https://panecrew.dev";
const canonical = `${siteUrl}${path}`;

const navItems = [
  { id: "index", href: "/docs/", label: "Overview" },
  { id: "install", href: "/docs/install/", label: "Install & run" },
  { id: "focus-following-explorer", href: "/docs/focus-following-explorer/", label: "Focus-following explorer" },
  { id: "cli", href: "/docs/cli/", label: "CLI reference" },
  { id: "shortcuts", href: "/docs/shortcuts/", label: "Keyboard shortcuts" },
];

const techArticleJsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  author: { "@type": "Organization", name: "PaneCrew" },
  publisher: { "@id": "https://panecrew.dev/#organization" },
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="article">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${siteUrl}/og-image.png`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${siteUrl}/og-image.png`}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" href="/favicon.png">
<script type="application/ld+json" set:html={JSON.stringify(techArticleJsonLd)} />
<style is:global>
  body {
    background:
      linear-gradient(180deg, var(--indigo-hi) 0%, var(--indigo) 16%, var(--indigo) 62%, #2a325f 88%, var(--indigo-hi) 100%);
    background-color: var(--indigo);
  }

  .foot { gap: 10px; }
  .glyph-tile { display: inline-flex; background: var(--indigo-deep); }
  .foot-gh { border: 1px solid rgba(35, 40, 63, 0.16); }

  /* ---------- docs two-column layout ---------- */
  .docs { padding: 48px 0 90px; display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 56px; }
  @media (max-width: 760px) {
    .docs { grid-template-columns: 1fr; gap: 28px; }
  }

  .docs-nav { font-size: 0.90625rem; }
  .docs-nav .eyebrow {
    font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--amber); margin-bottom: 14px;
  }
  .docs-nav ul { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .docs-nav a {
    display: block; text-decoration: none; padding: 7px 10px; border-radius: 8px;
    color: rgba(255, 253, 245, 0.72); transition: background var(--lift), color var(--lift);
  }
  .docs-nav a:hover { color: var(--cream); background: rgba(255, 253, 245, 0.06); }
  .docs-nav a[aria-current="page"] {
    color: var(--cream); background: rgba(229, 150, 86, 0.14);
    box-shadow: inset 2px 0 0 var(--amber);
  }

  .docs-content h1 {
    font-family: var(--display); font-weight: 700; font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.14; margin-bottom: 16px; text-wrap: balance;
  }
  .docs-content .lede {
    font-size: 1.0625rem; color: rgba(255, 253, 245, 0.88); max-width: 640px;
    margin-bottom: 30px; text-wrap: pretty;
  }

  /* prose rendering for the markdown-sourced reference pages (cli.md,
     shortcuts.md) — no classes on the generated HTML, so styled by tag. */
  .docs-md { max-width: 720px; }
  .docs-md h1 { font-family: var(--display); font-weight: 700; font-size: clamp(26px, 3.2vw, 36px); margin-bottom: 16px; }
  .docs-md h2 { font-family: var(--display); font-weight: 700; font-size: 1.375rem; margin: 34px 0 12px; color: var(--cream); }
  .docs-md h3, .docs-md h6 { font-size: 1rem; margin: 22px 0 8px; color: var(--cream); }
  .docs-md p { color: rgba(255, 253, 245, 0.82); margin-bottom: 12px; text-wrap: pretty; }
  .docs-md ul, .docs-md ol { color: rgba(255, 253, 245, 0.82); margin: 0 0 12px 1.2em; }
  .docs-md li { margin-bottom: 4px; }
  .docs-md a { color: var(--amber); }
  .docs-md code {
    font-family: var(--mono); font-size: 0.875em; background: rgba(255, 253, 245, 0.08);
    border-radius: 4px; padding: 0.1em 0.4em;
  }
  .docs-md pre {
    background: var(--term); border: 1px solid var(--term-line); border-radius: 10px;
    padding: 14px 16px; overflow-x: auto; margin-bottom: 16px;
  }
  .docs-md pre code { background: none; padding: 0; }
  .docs-md table { border-collapse: collapse; width: 100%; margin-bottom: 20px; font-size: 0.9375rem; }
  .docs-md th, .docs-md td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--line-dark); }
  .docs-md th { color: var(--cream); font-weight: 700; }
  .docs-md td { color: rgba(255, 253, 245, 0.82); }
</style>
<slot name="head" />
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <radialGradient id="mkChev" gradientUnits="userSpaceOnUse" cx="1330" cy="780" r="900">
      <stop offset="0" stop-color="#FEF2DE"/><stop offset="0.35" stop-color="#FFE9C8"/>
      <stop offset="0.56" stop-color="#FFD394"/><stop offset="0.8" stop-color="#FEBE63"/>
      <stop offset="1" stop-color="#FCAD43"/>
    </radialGradient>
    <linearGradient id="mkBlock" gradientUnits="userSpaceOnUse" x1="106" y1="0" x2="569" y2="0">
      <stop offset="0" stop-color="#FBB84E"/><stop offset="0.5" stop-color="#FEE0B6"/>
      <stop offset="1" stop-color="#FFF5E2"/>
    </linearGradient>
    <g id="mkGlyph">
      <path fill="url(#mkChev)" d="M800 115 L1494 810 L819 1485 L555 1485 L749 1218 L1157 810 L632 283 Z"/>
      <path fill="url(#mkBlock)" d="M106 1208 L569 1208 L368 1485 L106 1485 Z"/>
    </g>
    <path id="mkGithub" fill-rule="evenodd" clip-rule="evenodd" d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/>
    <!-- mkX: verbatim from simple-icons/simple-icons, branch `develop`,
         icons/x.svg (https://github.com/simple-icons/simple-icons), license
         CC0 1.0 Universal — same provenance convention as mkGithub above. -->
    <path id="mkX" d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/>
  </defs>
</svg>

<nav class="nav" aria-label="Main">
  <a class="logo" href="/">
    <svg viewBox="0 0 1600 1600" aria-hidden="true"><use href="#mkGlyph"/></svg>
    <b>PaneCrew</b>
  </a>
  <div class="nav-links">
    <a href="/#crew">The crew</a>
    <a href="/#demo">Live demo</a>
    <a href="/guides/multiple-cli-agent-sessions/">Guides</a>
    <a href="/docs/" aria-current={path.startsWith("/docs/") ? "page" : undefined}>Docs</a>
    <a href="/#oss">Open source</a>
    <a href="/#install">Install</a>
  </div>
  <div class="nav-end">
    <a class="nav-gh" href="https://github.com/silvio-l/panecrew" target="_blank" rel="noopener" aria-label="PaneCrew on GitHub">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><use href="#mkGithub"/></svg>
    </a>
    <a class="nav-gh" href="https://x.com/silviolindstedt" target="_blank" rel="noopener" aria-label="Silvio Lindstedt on X">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#mkX"/></svg>
    </a>
    <a class="nav-cta" href="/#install">get panecrew</a>
  </div>
</nav>

<main>
  <div class="docs wrap">
    <nav class="docs-nav" aria-label="Docs section">
      <p class="eyebrow">Docs</p>
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={item.id === active ? "page" : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="docs-content">
      <slot />
    </div>
  </div>
</main>

<svg class="wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
  <path fill="#fffdf5" d="M0 52 C 180 18 360 76 560 50 C 760 24 900 72 1100 48 C 1260 30 1360 52 1440 36 L 1440 80 L 0 80 Z"/>
</svg>
<footer>
  <div class="foot">
    <span class="glyph-tile" aria-hidden="true">
      <svg viewBox="0 0 1600 1600"><use href="#mkGlyph"/></svg>
    </span>
    <b>PaneCrew</b>
    <span class="cp">© 2026 PaneCrew</span>
    <a class="foot-gh" href="https://github.com/silvio-l/panecrew" target="_blank" rel="noopener" aria-label="PaneCrew on GitHub">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><use href="#mkGithub"/></svg>
    </a>
    <a class="foot-gh" href="https://x.com/silviolindstedt" target="_blank" rel="noopener" aria-label="Silvio Lindstedt on X">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#mkX"/></svg>
    </a>
  </div>
</footer>
</body>
</html>
