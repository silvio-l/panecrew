{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // @tauri-apps/api ist mit Ticket 02 (invoke/Channel/Webview-Drag-Drop) in
  // echten Gebrauch gekommen und steht deshalb nicht mehr hier. Seit dem
  // Über-Fenster (Links auf GitHub) gilt dasselbe für @tauri-apps/plugin-opener.

  // Knip erkennt splash.html/about.html/harness.html/settings.html als
  // weitere Vite-Einstiege, liest aber deren <script src> nicht — ohne diese
  // Einträge gelten die Module als tot. harness.html selbst ist NICHT in
  // vite.config.ts' rollupOptions.input registriert (ADR-0001, Ticket 01) —
  // das eine hält es aus dem Produktions-Bundle, das andere hier aus Knips
  // Totcode-Liste.
  "entry": [
    "src/splash/splash.ts",
    "src/about/main.tsx",
    "src/harness/main.tsx",
    "src/settings/main.tsx",
  ],

  // `wait` in den dev-Skripten ist das Shell-Builtin (Teil des
  // trap-'kill 0'-Idioms, das Vite-Kindprozesse beim Beenden mitnimmt) —
  // kein npm-Binary, das Knip auflösen könnte.
  "ignoreBinaries": ["wait"]
}
