<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Vendored copy of tauri-build's own bundled default
  (tauri-build-2.6.3/src/windows-app-manifest.xml) — supplied here instead of
  letting tauri-build embed it itself, since tauri-build only links its copy
  into `[[bin]]` targets, never the `cargo test` harness (see build.rs for
  why that leaves the test binary crashing on startup). If a future
  tauri-build release adds more to its own default (DPI-awareness,
  longPathAware, …), this copy won't pick that up automatically — diff
  against the crate's own file when bumping tauri-build.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"> <!-- brandlint-ok: required literal XML namespace URI, not prose -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0" processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" /> <!-- brandlint-ok: required literal SxS assembly-identity string, not prose -->
    </dependentAssembly>
  </dependency>
</assembly>
